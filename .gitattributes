# 统一换行符为 LF，避免跨平台协作产生整文件 diff
# 依据：SPEC-02 §2.1 字符与编码
* text=auto eol=lf

# 二进制文件不做换行转换
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.docx binary
*.xlsx binary
*.pptx binary
*.mp4  binary
*.woff  binary
*.woff2 binary
*.ttf   binary

# Markdown 与文本文件按 LF 处理
*.md   text eol=lf
*.json text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.py   text eol=lf
*.html text eol=lf
*.css  text eol=lf
*.js   text eol=lf

# 语言统计时排除文档与数据，聚焦真实代码
docs/**      linguist-documentation
templates/** linguist-documentation
iteration-log/** linguist-documentation

# LICENSE 避免被识别为其他语言
LICENSE linguist-vendored
